# Server Configuration
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://ekokapital.com

# Session & Security (WAJIB diganti string acak panjang di VPS production)
SESSION_SECRET=change-me-to-a-64-char-random-hex-secret-in-production

# Initial Admin Seed Credentials (hanya dipakai saat inisialisasi DB pertama kali; segera ubah di /admin/settings)
INITIAL_ADMIN_EMAIL=admin@ekokapital.com
INITIAL_ADMIN_PASSWORD="EkoAdmin#2026!ChangeMe"

# Database & Uploads Paths (relative to project root or absolute path on VPS)
DATABASE_PATH=./data/ekokapital.db
UPLOADS_DIR=./uploads
